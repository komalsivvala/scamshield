# Nebius Token Factory (https://tokenfactory.nebius.com) — required
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Tavily (https://tavily.com) — required for live web investigation
TAVILY_API_KEY=

# Optional: pin exact model ids. Leave blank to auto-select the best Nemotron models
# available on your Token Factory account (Nano for fast calls, Ultra for reasoning, Omni/VL for screenshots).
FAST_MODEL=
REASON_MODEL=
VISION_MODEL=

# Development only: 1 = canned AI output for UI work (clearly labelled MOCK in the UI)
MOCK_MODE=0
